#include <stdbool.h>
#include <string.h>

bool isAnagram(char* s, char* t) {
    // Step 1: Check if the string lengths are equal
    int len_s = strlen(s);
    int len_t = strlen(t);
    if (len_s != len_t) {
        return false;
    }
    
    // Step 2: Initialize a frequency array for the 26 lowercase letters
    int count[26] = {0};
    
    // Step 3: Increment counts for string s, decrement counts for string t
    for (int i = 0; i < len_s; i++) {
        count[s[i] - 'a']++;
        count[t[i] - 'a']--;
    }
    
    // Step 4: Verify if all counts returned to zero
    for (int i = 0; i < 26; i++) {
        if (count[i] != 0) {
            return false;
        }
    }
    
    return true;
}
