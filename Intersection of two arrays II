#include <stdlib.h>
#include <string.h>

/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
int* intersect(int* nums1, int nums1Size, int* nums2, int nums2Size, int* returnSize) {
    // 1. Initialize a frequency table for the constraint 0 <= nums[i] <= 1000
    int counts[1001] = {0};
    
    // 2. Count occurrences of each number in the first array
    for (int i = 0; i < nums1Size; i++) {
        counts[nums1[i]]++;
    }
    
    // 3. Allocate memory for the result array
    int minSize = (nums1Size < nums2Size) ? nums1Size : nums2Size;
    int* result = (int*)malloc(minSize * sizeof(int));
    int count = 0;
    
    // 4. Find matches using the second array
    for (int i = 0; i < nums2Size; i++) {
        if (counts[nums2[i]] > 0) {
            result[count++] = nums2[i];
            counts[nums2[i]]--; // Decrement frequency to track duplicates accurately
        }
    }
    
    // 5. Set the output size and return the resulting array
    *returnSize = count;
    return result;
}
